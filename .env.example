# =================================================================
#  ZDBF - environment file
#
#  Copy this file to ".env" and fill in what you need.
#  Only DISCORD_TOKEN is required. Everything else is optional.
#
#  This file holds secrets and per-process values only.
#  All other settings (prefix, modules, logging, backups ...) live
#  in config.toml, which is created on first start.
# =================================================================


# -----------------------------------------------------------------
#  REQUIRED
# -----------------------------------------------------------------

# Bot token from https://discord.com/developers/applications
#   -> your application -> Bot -> Reset Token
DISCORD_TOKEN=


# -----------------------------------------------------------------
#  OPTIONAL - owners
# -----------------------------------------------------------------

# The application owner (or every member of the owning team) is
# detected automatically. Add extra owner user IDs here, comma separated.
# BOT_OWNER_ID=123456789012345678,234567890123456789


# -----------------------------------------------------------------
#  OPTIONAL - config file location
# -----------------------------------------------------------------

# Default: ./config.toml (can also be passed with: python -m zdbf --config path)
# ZDBF_CONFIG=./config.toml


# -----------------------------------------------------------------
#  OPTIONAL - sharding (one process)
# -----------------------------------------------------------------

# Leave both empty and Discord picks the shard count for you.
# Only needed for very large bots (2,500+ servers).
#
# Total number of shards across all processes:
# SHARD_COUNT=4
#
# The shards this process runs (comma separated). Empty = all of them.
# SHARD_IDS=0,1


# -----------------------------------------------------------------
#  OPTIONAL - clusters (several processes or machines)
#  Only used when [modules] cluster = true in config.toml.
# -----------------------------------------------------------------

# Shared secret, at least 16 random characters, identical everywhere.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SHARD_IPC_SECRET=

# "server" on exactly one process, "client" on all others.
# SHARD_IPC_MODE=server

# Name shown in /cluster status (unique per process).
# SHARD_CLUSTER_NAME=cluster-0

# Where the server listens / clients connect.
# Defaults come from [cluster] in config.toml (127.0.0.1:20000).
# SHARD_IPC_HOST=127.0.0.1
# SHARD_IPC_PORT=20000


# -----------------------------------------------------------------
#  NOT NEEDED
# -----------------------------------------------------------------
#  Client ID       - read from Discord automatically at login.
#  Client secret   - only used for website logins (OAuth2). The bot
#                    never needs it, so do not store it here.
